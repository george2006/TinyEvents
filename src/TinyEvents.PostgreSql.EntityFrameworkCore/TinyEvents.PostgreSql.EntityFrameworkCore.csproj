<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents.PostgreSql.EntityFrameworkCore</PackageId>
    <Description>PostgreSQL EF Core provider for transactional outbox storage, worker claiming, and explicit built-in migrations.</Description>
    <PackageTags>tinyevents;outbox;postgresql;postgres;efcore;dotnet;source-generator</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents\TinyEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TinyEvents.Migrations\**\*.cs"
             Link="Migrations\Common\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shared\TinyEvents.PostgreSql.Migrations\**\*.cs"
             Link="Migrations\PostgreSql\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents.PostgreSql.EntityFrameworkCore 0.1.0-alpha.3

      Added
      - Forward-only built-in PostgreSQL migrations with strict history and checksums.
      - Session-scoped advisory locking, timeout, cancellation, and concurrency safety.
      - Existing alpha outbox baselining without recreating the table.
      - Structured migration logging and public MigrateTinyEventsAsync support.

      Ownership
      - Migration execution borrows the scoped DbContext connection and preserves its ownership and open state.
      - Publishing still commits business data and outbox messages through caller-owned SaveChangesAsync.

      Compatibility
      - Early alpha / active development.
      - Upgrade every TinyEvents package in the application to alpha.3 together.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
