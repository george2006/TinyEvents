<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents</PackageId>
    <Description>Provider-agnostic transactional outbox with generated event dispatch, durable processing, and explicit database migrations.</Description>
    <PackageTags>events;outbox;source-generator;dotnet;dependency-injection;tinyevents</PackageTags>
  </PropertyGroup>
  <PropertyGroup>
    <PackagedSourceGeneratorPath>$(MSBuildThisFileDirectory)..\TinyEvents.SourceGen\bin\$(Configuration)\netstandard2.0\TinyEvents.SourceGen.dll</PackagedSourceGeneratorPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents.SourceGen\TinyEvents.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(PackagedSourceGeneratorPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" Condition="Exists('$(PackagedSourceGeneratorPath)')" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents 0.1.0-alpha.3

      Added
      - Public MigrateTinyEventsAsync entry point and scoped migrator contract.
      - Generated event dispatchers that avoid runtime reflection and assembly scanning.
      - Structured, secret-safe outbox processing and migration logging.
      - Explicit database-provider registration exclusivity and option validation.

      Hardened
      - Cancellation boundaries, retry persistence, lease-loss detection, and failure classification.
      - Multi-assembly generated consumer registration and package boundaries.

      Compatibility
      - Early alpha / active development.
      - APIs may change before 1.0.
      - Upgrade every TinyEvents package in the application to alpha.3 together.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
