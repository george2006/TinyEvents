<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents</PackageId>
    <Description>Provider-agnostic transactional outbox with generated event dispatch, durable processing, and explicit database migrations.</Description>
    <PackageTags>events;outbox;source-generator;dotnet;dependency-injection;tinyevents</PackageTags>
  </PropertyGroup>
  <PropertyGroup>
    <PackagedSourceGeneratorPath>$(MSBuildThisFileDirectory)..\TinyEvents.SourceGen\bin\$(Configuration)\netstandard2.0\TinyEvents.SourceGen.dll</PackagedSourceGeneratorPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents.SourceGen\TinyEvents.SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="$(PackagedSourceGeneratorPath)" Pack="true" PackagePath="analyzers/dotnet/cs/" Visible="false" Condition="Exists('$(PackagedSourceGeneratorPath)')" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents 1.0.0-beta.2

      - Added ITinyOutboxStatusReader and TinyOutboxStatus for read-only outbox counts and activity timestamps.
      - No new migration is required when upgrading from beta.1.
      - Upgrade every TinyEvents package in the application to beta.2 together.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
