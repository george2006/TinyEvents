<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents.SqlServer.EntityFrameworkCore</PackageId>
    <Description>SQL Server EF Core provider for transactional outbox storage, worker claiming, and explicit built-in migrations.</Description>
    <PackageTags>tinyevents;outbox;sqlserver;efcore;dotnet;source-generator</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents\TinyEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TinyEvents.Migrations\**\*.cs"
             Link="Migrations\Common\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shared\TinyEvents.SqlServer.Migrations\**\*.cs"
             Link="Migrations\SqlServer\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents.SqlServer.EntityFrameworkCore 0.1.0-beta.1

      Added
      - Bounded atomic cleanup of eligible processed messages.
      - Migration 002_AddProcessedCleanupIndex for ordered cleanup lookups.

      Hardened
      - SQL Server processing, retries, lease recovery, cleanup, migrations, and rolling upgrades against a real database.
      - Current migration history now rejects a missing outbox table instead of accepting inconsistent schema state.

      Compatibility
      - Evidence-backed pre-1.0 beta with caller-owned SaveChangesAsync publishing.
      - Upgrade every TinyEvents package in the application to beta.1 together.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
