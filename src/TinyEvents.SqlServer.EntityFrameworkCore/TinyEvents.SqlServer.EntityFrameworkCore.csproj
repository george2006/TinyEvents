<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents.SqlServer.EntityFrameworkCore</PackageId>
    <Description>SQL Server EF Core provider for transactional outbox storage, worker claiming, and explicit built-in migrations.</Description>
    <PackageTags>tinyevents;outbox;sqlserver;efcore;dotnet;source-generator</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.16" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.16" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents\TinyEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TinyEvents.Migrations\**\*.cs"
             Link="Migrations\Common\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shared\TinyEvents.SqlServer.Migrations\**\*.cs"
             Link="Migrations\SqlServer\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents.SqlServer.EntityFrameworkCore 1.0.0-beta.2

      - Existing provider registration now includes scoped ITinyOutboxStatusReader for outbox counts and activity timestamps.
      - No new migration is required when upgrading from beta.1.
      - Upgrade every TinyEvents package in the application to beta.2 together.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
