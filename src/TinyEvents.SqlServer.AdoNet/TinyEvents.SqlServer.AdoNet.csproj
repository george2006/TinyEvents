<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents.SqlServer.AdoNet</PackageId>
    <Description>SQL Server ADO.NET provider for TinyEvents outbox storage and worker claiming.</Description>
    <PackageTags>tinyevents;outbox;sqlserver;ado.net;dotnet;source-generator</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents\TinyEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TinyEvents.Migrations\**\*.cs"
             Link="Migrations\Common\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="Schema\SqlServer\*.sql" Pack="true" PackagePath="schema\sqlserver" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents.SqlServer.AdoNet 0.1.0-alpha.2

      Added
      - Alpha.2 release train alignment with the expanded provider family.
      - Provider-specific documentation and package README updates.
      - Sample documentation updates for database-specific sample projects.

      Notes
      - Early alpha / active development.
      - APIs may change before 1.0.
      - SQL Server ADO.NET runtime behavior is unchanged in this release train.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
