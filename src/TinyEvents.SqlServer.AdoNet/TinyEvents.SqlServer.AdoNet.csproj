<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents.SqlServer.AdoNet</PackageId>
    <Description>SQL Server ADO.NET provider for transactional outbox storage, worker claiming, and explicit built-in migrations.</Description>
    <PackageTags>tinyevents;outbox;sqlserver;ado.net;dotnet;source-generator</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents\TinyEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\TinyEvents.Migrations\**\*.cs"
             Link="Migrations\Common\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Shared\TinyEvents.SqlServer.Migrations\**\*.cs"
             Link="Migrations\SqlServer\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="Schema\SqlServer\*.sql" Pack="true" PackagePath="schema\sqlserver" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents.SqlServer.AdoNet 0.1.0-alpha.3

      Added
      - Forward-only built-in SQL Server migrations with strict history and checksums.
      - Session-scoped migration locking, timeout, cancellation, and concurrency safety.
      - Existing alpha outbox baselining without recreating the table.
      - Structured migration logging and public MigrateTinyEventsAsync support.

      Ownership
      - Migration execution reuses UseWorkerConnectionFactory and disposes its dedicated connection.
      - Application publishing connections and transactions remain caller-owned.

      Compatibility
      - Early alpha / active development.
      - APIs may change before 1.0.
      - Upgrade every TinyEvents package in the application to alpha.3 together.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
