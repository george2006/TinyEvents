<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents.Worker</PackageId>
    <Description>Validated, resilient hosted worker integration for TinyEvents outbox processing.</Description>
    <PackageTags>events;outbox;worker;hosting;dotnet;tinyevents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents\TinyEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents.Worker 1.0.0-beta.2

      - Coordinated release with the new provider outbox status reader; hosted worker behavior is unchanged.
      - No new migration is required when upgrading from beta.1.
      - Upgrade every TinyEvents package in the application to beta.2 together.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
