<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents.Worker</PackageId>
    <Description>Validated, resilient hosted worker integration for TinyEvents outbox processing.</Description>
    <PackageTags>events;outbox;worker;hosting;dotnet;tinyevents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents\TinyEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents.Worker 0.1.0-alpha.3

      Added
      - Startup validation for the generated dispatcher graph and provider-specific dependencies.
      - Structured worker failure, recovery, retry-exhaustion, and lease-loss logging.
      - Configurable, validated worker polling, batching, claim, and retry options.

      Hardened
      - Iteration failures no longer terminate the hosted worker.
      - Cancellation remains distinct from operational failure and retry behavior.

      Compatibility
      - Early alpha / active development.
      - APIs may change before 1.0.
      - Requires a matching alpha.3 TinyEvents core and exactly one database provider.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
