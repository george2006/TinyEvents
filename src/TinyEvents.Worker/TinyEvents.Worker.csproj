<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>TinyEvents.Worker</PackageId>
    <Description>Validated, resilient hosted worker integration for TinyEvents outbox processing.</Description>
    <PackageTags>events;outbox;worker;hosting;dotnet;tinyevents</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TinyEvents\TinyEvents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyEvents.Worker 0.1.0-beta.1

      Added
      - Independent hosted cleanup service for bounded processed-message retention.
      - Configurable cleanup enablement, retention, batch size, and interval.

      Hardened
      - Cleanup failures remain isolated from event processing.
      - Worker and cleanup options validate their active capabilities without blocking custom providers that disable cleanup.
      - Package smoke tests exercise both hosted services through public registration.

      Compatibility
      - Evidence-backed pre-1.0 beta with documented at-least-once boundaries.
      - Requires matching beta.1 TinyEvents core and database provider packages.
    </PackageReleaseNotes>
  </PropertyGroup>
</Project>
